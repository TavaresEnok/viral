NODE_BIND=0.0.0.0
NODE_PORT=9873
NODE_KEY=CHANGE_ME_chave_forte
NODE_DIR=/caminho/para/node_agent/tmp
NODE_MODEL=turbo
NODE_DEVICE=cuda
NODE_BATCH_SIZE=1
NODE_COMPUTE_TYPE=int8
NODE_PREWARM=true
NODE_CACHE_ENABLED=true
NODE_MAX_CONCURRENT=1
# Render roda no GPU (nvenc + face tracking). RTX 5060 Ti 16GB fica ociosa com 1.
# 3 renders simultâneos saturam o encoder sem estourar VRAM (~1-2GB cada).
NODE_RENDER_MAX_CONCURRENT=3
NODE_NORMALIZE_AUDIO=false
NODE_FACE_TRACKING_ENABLED=true
NODE_FACE_MODEL=buffalo_sc
NODE_FACE_DET_SIZE=320
NODE_FACE_SAMPLE_FPS=3
NODE_FACE_TRACKING_LAYOUTS=SMART_REFRAME,SPEAKER_CLOSEUP
NODE_FACE_PREWARM=false
NODE_FACE_DEVICE=cuda
NODE_FACE_BACKEND=yolo
# Path PERSISTENTE (antes apontava p/ /tmp/node-agent que não existia → face
# tracking caía em crop estático e o prewarm falhava todo boot). .onnx (seguro,
# sem pickle). Validado: detecta faces, 1.1s/inferência após warmup.
NODE_YOLO_FACE_MODEL=/caminho/para/node_agent/models/yolov11n-face.onnx
NODE_FACE_MIN_SCORE=0.30
NODE_FACE_EMA_ALPHA=0.10
NODE_FACE_DEADZONE_RATIO=0.10
NODE_FACE_MAX_SPEED_RATIO=0.55
NODE_FACE_MOVE_THRESHOLD_RATIO=0.18
NODE_FACE_MOVE_DURATION=0.35
NODE_FACE_CENTER_BIAS_Y=0.42
NODE_FACE_MAX_ACCEL_RATIO=1.10

# Descarrega o Whisper da GPU ao fim de cada transcrição (GPU livre quando ocioso)
NODE_UNLOAD_ASR_AFTER_USE=true

# Descarrega o modelo facial da GPU após N min sem render (bom vizinho)
NODE_FACE_IDLE_UNLOAD_MINUTES=10
