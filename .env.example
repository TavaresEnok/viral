# ViralForge — Environment Variables Example
# Copy to .env and fill in your values. NEVER commit .env files.
#
# Legend:
#   (required)  — app will not work correctly in production without it
#   (optional)  — has a safe default or enables a non-core feature

# ─── Database ──────────────────────────────────────────────────────────────────
# Full connection string. Overrides individual POSTGRES_* vars below if set.
DATABASE_URL=postgresql://viralforge:CHANGE_ME@localhost:5432/viralforge?schema=public

# Used by docker-compose.prod.yml to configure the postgres service
POSTGRES_USER=viralforge
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=viralforge

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=        # Set if Redis requires auth (recommended in production)
# REDIS_URL=redis://...  # Alternative: full URL form (overrides HOST/PORT/PASSWORD)

# ─── Application Secrets (required) ────────────────────────────────────────────
# At least 32 chars, ideally 64 hex chars. Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_minimum_32_chars_long_secret
MASTER_SECRET=CHANGE_ME_minimum_32_chars_long_secret
API_KEY_ENCRYPTION_SECRET=CHANGE_ME_minimum_32_chars_long_secret

# ─── Storage ───────────────────────────────────────────────────────────────────
STORAGE_ROOT=storage/uploads
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=CHANGE_ME
# MINIO_SECRET_KEY=CHANGE_ME
# MINIO_ROOT_USER=viralforge        # Used by docker-compose.prod.yml
# MINIO_ROOT_PASSWORD=CHANGE_ME     # Used by docker-compose.prod.yml

# ─── API Config ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
# API_PORT=3001
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000,http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3001
# APP_VERSION=0.1.0                  # Reported in health checks and Sentry releases
# REFRESH_COOKIE_NAME=vf_refresh     # Name of the refresh-token cookie
# TRUST_PROXY=loopback               # Set when behind nginx/load balancer so client IPs
                                     # (rate limit / audit) are read from X-Forwarded-For.
                                     # Defaults to 'loopback' in production, '' otherwise.

# ─── Email / SMTP (required in production) ─────────────────────────────────────
# WITHOUT THIS, email verification and password-reset links are only logged to the
# console — users cannot verify accounts or reset passwords. Use any SMTP provider
# (Resend, Amazon SES, Postmark, Mailgun, Gmail app password, etc.).
SMTP_HOST=                            # e.g. smtp.resend.com
SMTP_PORT=587                         # 465 = implicit TLS, 587 = STARTTLS
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ViralForge <noreply@viralforge.app>

# ─── AI Providers (optional — system works without these in fallback mode) ─────
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# ALLOW_PRIVATE_PROVIDER_BASE_URLS=false  # Allow user-configured provider base URLs
                                          # pointing at private/loopback IPs (SSRF guard).

# ─── Remote ASR Accelerator (optional) ────────────────────────────────────────
# REMOTE_ACCEL_ENABLED=false
# REMOTE_ACCEL_BASE_URL=http://127.0.0.1:9873
# REMOTE_ACCEL_TOKEN=
# REMOTE_ACCEL_MODEL=turbo
# REMOTE_ACCEL_DEVICE=cuda
# REMOTE_ACCEL_COMPUTE_TYPE=float16
# REMOTE_ACCEL_BATCH_SIZE=8
# REMOTE_ACCEL_TIMEOUT_MS=600000
# REMOTE_ACCEL_ALLOW_URL_FALLBACK=false

# ─── Worker / Rendering Config ─────────────────────────────────────────────────
WORKER_CONCURRENCY=1
RENDER_CLIP_CONCURRENCY=1
FFMPEG_THREADS=2
FFMPEG_PRESET=veryfast
# FFMPEG_TIMEOUT_MS=1800000           # Hard timeout for a single ffmpeg invocation
# RENDER_ENGINE=ffmpeg                # 'remotion' enables animated captions + auto overlays
# REMOTION_CONCURRENCY=8
# ENABLE_AUTO_EMOJI=false             # Global default for auto emoji overlays (Remotion only)
# ENABLE_AUTO_SFX=false               # Global default for auto SFX overlays (Remotion only)
# WORKER_HEALTH_PORT=3010             # Worker /health endpoint port
# REMOTE_RENDER_ENABLED=false         # Offload rendering to a remote GPU render service
# REMOTE_RENDER_TIMEOUT_MS=1800000

# ─── Job Timeouts / Watchdog (optional) ───────────────────────────────────────
# PROJECT_PROCESSING_TIMEOUT_MINUTES=180  # Mark a stuck project FAILED after N minutes
# CLIP_RENDER_TIMEOUT_MINUTES=45          # Mark a stuck render FAILED after N minutes
# ORPHAN_PROJECT_GRACE_MINUTES=10         # Grace before an orphaned project is reaped

# ─── Social Publishing — YouTube (optional) ───────────────────────────────────
# Register an app in Google Cloud Console with the YouTube Data API v3 enabled.
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REDIRECT_URI are accepted as aliases.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=https://your-domain.com/api/publish/youtube/callback
# YOUTUBE_CAPTIONS_ONLY=false         # Upload only captions instead of the full video

# ─── Social Publishing — TikTok (optional) ────────────────────────────────────
# Login Kit (OAuth) + Content Posting API. Registre um app em developers.tiktok.com.
# Scopes: user.info.basic, video.publish, video.upload (postar público exige auditoria).
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://your-domain.com/api/publish/tiktok/callback
# TIKTOK_OPEN_API_KEY=                 # (legado; usado no serviço de publicação)

# ─── Social Publishing — Instagram (optional) ─────────────────────────────────
# Facebook Login → Instagram Graph API. Registre um app em developers.facebook.com.
# A conta IG precisa ser Business e estar vinculada a uma Página do Facebook.
# INSTAGRAM_APP_ID / INSTAGRAM_APP_SECRET (aceita META_APP_ID / FACEBOOK_APP_ID como alias).
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=https://your-domain.com/api/publish/instagram/callback
# Instagram puxa o vídeo de uma URL PÚBLICA, então o corte renderizado precisa ser acessível.
# INSTAGRAM_MEDIA_BASE_URL=https://your-domain.com/clips   # Public base URL for clip files
# INSTAGRAM_PUBLIC_DIR=public/clips                        # Local dir served at that URL

# ─── B-roll (optional, EXPERIMENTAL) ──────────────────────────────────────────
# PEXELS_API_KEY=                     # Enables automatic B-roll footage from Pexels
# BROLL_ENABLED=false                 # Liga cutaways de B-roll no render (ffmpeg).
#                                     # Off por padrão. Requer PEXELS_API_KEY e
#                                     # validação com vídeo real antes de produção.

# ─── Stripe Billing (required to charge) ──────────────────────────────────────
# Create products/prices first: `pnpm stripe:setup`. Register the webhook endpoint
# (https://your-domain.com/api/billing/webhook) and copy its signing secret.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_STUDIO=price_...

# ─── Rate Limiting / Brute Force (optional — sane defaults applied) ───────────
# GLOBAL_RATE_LIMIT=60               # Requests/min per IP (all routes)
# GLOBAL_RATE_LIMIT_TTL_MS=60000
# AUTH_RATE_LIMIT=10                 # login, register, refresh, forgot/reset-password, verify-email
# AUTH_RATE_LIMIT_TTL_MS=60000
# PROJECT_WRITE_RATE_LIMIT=20        # project create, upload, youtube import, retry
# PROJECT_WRITE_RATE_LIMIT_TTL_MS=60000
# REDIS_RATE_LIMIT_ENABLED=true      # Set false to force in-memory rate limit store
# REDIS_BRUTE_FORCE_ENABLED=true     # Set false to force in-memory brute-force store
# BRUTE_FORCE_MAX_ATTEMPTS=5
# BRUTE_FORCE_WINDOW_MS=900000       # 15 min sliding window
# BRUTE_FORCE_LOCK_MS=900000         # 15 min lockout after threshold

# ─── Observability (optional but recommended) ────────────────────────────────
# Backend (API + worker):
# SENTRY_DSN=https://...
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Frontend (Next.js — must be NEXT_PUBLIC_ to reach the browser):
# NEXT_PUBLIC_SENTRY_DSN=https://...
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Product analytics (optional):
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Backup (optional) ─────────────────────────────────────────────────────────
# BACKUP_CRON_SCHEDULE=0 3 * * *   # Daily at 03:00 UTC (default)

# ─── Worker: retenção e timeouts ─────────────────────────────────────────────
# STORAGE_RETENTION_DAYS=14          # Apaga originais re-baixáveis (com sourceUrl) de projetos COMPLETED/FAILED após N dias; 0 desativa
# PUBLISH_TIMEOUT_MINUTES=15         # Watchdog: publicação presa em PUBLISHING além disso vira FAILED
# YOUTUBE_DOWNLOAD_TIMEOUT_MS=900000 # Timeout do download do vídeo (padrão 15 min)
# YOUTUBE_TRANSCRIPT_TIMEOUT_MS=60000

# ─── IA: fallback explícito ──────────────────────────────────────────────────
# ALLOW_AI_FALLBACK=false  # Em produção: falha o projeto (com mensagem acionável)
#                          # quando a IA não produz cortes válidos, em vez de gerar
#                          # cortes sintéticos silenciosamente. Padrão: true.
#                          # Clips de fallback nunca podem ser AGENDADOS para
#                          # publicação (só publicação manual imediata).
# AUDIT_RETENTION_DAYS=180          # Retenção do AuditLog; 0 desativa
