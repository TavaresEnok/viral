{
  "name": "@viralforge/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "App mobile (Capacitor) que empacota o web app ViralForge para Play Store + APK.",
  "scripts": {
    "cap": "cap",
    "add:android": "cap add android",
    "sync": "cap sync",
    "open:android": "cap open android",
    "run:android": "cap run android",
    "build:apk": "cd android && ./gradlew assembleDebug",
    "build:aab": "cd android && ./gradlew bundleRelease",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.2",
    "@capacitor/browser": "^6.0.5",
    "@capacitor/core": "^6.1.2",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/share": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@types/node": "^20.17.57",
    "typescript": "^5.8.3"
  }
}
