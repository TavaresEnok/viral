{
  "name": "@viralforge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "corepack pnpm --filter @viralforge/shared build && corepack pnpm --filter @viralforge/database build && tsc -p tsconfig.json && node --env-file=../../.env dist/apps/api/src/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.4",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.56.0",
    "@types/nodemailer": "^8.0.0",
    "@viralforge/database": "workspace:*",
    "@viralforge/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.58.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.7.0",
    "multer": "2.1.1",
    "nodemailer": "^8.0.10",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.23",
    "@types/multer": "^1.4.13",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
