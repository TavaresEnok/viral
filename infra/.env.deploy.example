# ==========================================================================
# Exemplo de configuração para o deploy Docker single-host.
#
#   cp infra/.env.deploy.example infra/.env.deploy
#   # gere segredos fortes (>=32 chars) para JWT_SECRET e MASTER_SECRET:
#   openssl rand -hex 32
#
# O arquivo real (infra/.env.deploy) é ignorado pelo git — nunca versione
# segredos. Suba com:
#   docker compose -p viralforge --env-file infra/.env.deploy \
#     -f infra/docker-compose.deploy.yml up -d --build
# ==========================================================================

# --- Banco (interno à rede docker, sem porta no host) ---
POSTGRES_USER=viralforge
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=viralforge

# --- Segredos de app: mínimo 32 caracteres cada (openssl rand -hex 32) ---
JWT_SECRET=troque-por-um-hex-de-64-caracteres-gerado-com-openssl-rand
MASTER_SECRET=troque-por-outro-hex-de-64-caracteres-gerado-com-openssl-rand

# --- Origem pública. Ajuste host/porta conforme sua exposição. ---
WEB_ORIGIN=http://SEU-IP:8090
NEXT_PUBLIC_API_URL=/api

# --- IA. Sem chave, o pipeline usa fallback local (qualidade limitada).
# Configure as chaves em /dashboard/settings ou /admin/ai depois de subir. ---
ALLOW_AI_FALLBACK=true
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# --- Teto de custo por análise. Aborta ANTES de chamar o modelo. ---
LLM_MAX_COST_USD=0.5
LLM_MAX_OUTPUT_TOKENS=8000
LLM_TIMEOUT_MS=120000
# Vídeo longo analisado em janelas em vez de amostrado. false = modo antigo.
LLM_MAP_REDUCE=true

# --- Faxina automática de arquivos antigos (0 desativa) ---
STORAGE_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=90

# --- Concorrência do worker. Baixe os valores se o host for compartilhado. ---
WORKER_CONCURRENCY=1
# Menos processos com mais threads rende mais: medido em 8 cortes de 30s,
# concorrencia=2/threads=4 levou 34,8s contra 37,1s de concorrencia=4/threads=2.
# Tambem usa metade das sessoes NVENC e ~1GB a menos de RAM.
RENDER_CLIP_CONCURRENCY=2
FFMPEG_THREADS=4
FFMPEG_PRESET=veryfast
REMOTION_CONCURRENCY=2

# --- Engine de render. Padrão FFmpeg; descomente para usar Remotion. ---
# RENDER_ENGINE=remotion
REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium

# --- Opcionais ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=

# --- Aceleracao por GPU (opcional; detectada automaticamente no boot) ---
# O sistema funciona sem placa: sem GPU, o encode usa libx264 e a transcricao
# segue pelo caminho local/API. Nada aqui e obrigatorio nesse caso.
#
# Encode: VIDEO_ENCODER=cpu forca CPU mesmo com placa presente.
# VIDEO_ENCODER=auto
# NVENC_PRESET=p4
# NVENC_CQ=23
#
# Transcricao Whisper na GPU (node-agent, so sobe quando ha placa).
# Gere a chave com: openssl rand -hex 32
NODE_KEY=troque-por-um-hex-gerado-com-openssl-rand-hex-32
REMOTE_ACCEL_MODEL=turbo
REMOTE_ACCEL_COMPUTE_TYPE=float16

# --- Velocidade no modo GPU (opcional; ignorado sem placa) ---
# Mantem o Whisper residente na VRAM (~2GB de 16GB) para o primeiro video
# nao esperar o carregamento. ATENCAO: NODE_PREWARM sozinho nao basta —
# o app ignora o prewarm quando NODE_UNLOAD_ASR_AFTER_USE fica em true.
NODE_PREWARM=true
NODE_UNLOAD_ASR_AFTER_USE=false
NODE_MAX_CONCURRENT=2
REMOTE_ACCEL_BATCH_SIZE=8
# Timeout do face tracking remoto (SMART_REFRAME/SMART_CENTER/SPEAKER_CLOSEUP/
# PODCAST_SPLIT_STATIC). Opcional — o codigo ja usa 2min como padrao; so
# precisa disto se cortes muito longos estiverem estourando o timeout.
# REMOTE_ACCEL_FACE_TIMEOUT_MS=120000
# Cortes em paralelo quando o encode e por NVENC (a CPU fica livre).
# Teto real desta GPU: 12 sessoes NVENC simultaneas (a 13a falha com
# OpenEncodeSessionEx). Mantenha folga — o DRAC divide a mesma placa.
RENDER_CLIP_CONCURRENCY_GPU=2
# Layout padrao (BLURRED_BACKGROUND) inteiramente em CUDA (decode+filtros),
# nao so o encode. Medido no mesmo corte de 30s por tempo de CPU real
# (usuario+sistema do processo, nao so o relogio): filtros CPU consomem 14,5s
# de CPU somada contra 11,7s dos filtros CUDA — ~19% menos CPU total, as custas
# de ficar mais lento por corte (6,3s -> 9,1s de parede). Os outros layouts
# usam recorte de enquadramento exato, sem equivalente em frames de GPU; eles
# continuam com os filtros na CPU, so o decode vai pra GPU de graca.
# false volta pros filtros de CPU sem tocar no encode NVENC.
RENDER_GPU_FILTERS=true
# Encode na GPU. Vazio = deteccao automatica, tentando av1_nvenc -> hevc_nvenc
# -> h264_nvenc e ficando no primeiro que a placa aceitar (av1_nvenc so existe
# em RTX 40 ou mais novas). Medido nesta placa contra referencia sem perdas:
# AV1 cq31 = 2,58MB/SSIM 0,9909 contra HEVC cq25 = 2,96MB/SSIM 0,9907 — mesma
# qualidade em 13% menos bytes, no mesmo tempo. Preencha para fixar um codec:
# h264_nvenc e o mais compativel se algum destino recusar AV1.
NVENC_CODEC=
NVENC_PRESET=p4
# Vazio usa o padrao por codec: 31 (AV1), 25 (HEVC), 23 (H.264).
NVENC_CQ=
